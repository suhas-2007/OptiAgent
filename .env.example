# ==============================================================================
# OptiAgent Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your actual API keys.
# NEVER commit your actual .env file or production secrets to source control.

# Google Gemini API Key
# Required for:
# - Multimodal problem extraction (/api/extract-problem)
# - AI strategy planning and transitions (backend/ai_planner.py)
# - Optimization tutoring assistant (/api/ask-info)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional backup keys for quota/fallback resilience
# GEMINI_BACKUP_KEY=your_backup_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# Gemini Model Selection (default: gemini-3.5-flash-lite)
# Supported options: gemini-3.5-flash-lite, gemini-2.5-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Backend HTTP Server Port (default: 5000)
PORT=5000

# Environment Mode (production / development)
FLASK_ENV=production
